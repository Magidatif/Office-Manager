{
  "name": "daily-office-manager",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Daily Office Manager — نظام إدارة ومتابعة الأعمال اليومية لمكتب الإدارة الفنية",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:worker": "esbuild worker/index.ts --bundle --target=es2022 --format=esm --outfile=dist-worker/index.js --external:cloudflare:*",
    "preview": "vite preview",
    "wrangler:dev": "wrangler dev",
    "wrangler:deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply daily-office-db --local",
    "d1:migrate:prod": "wrangler d1 migrations apply daily-office-db --remote",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "hono": "^4.13.16",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wrangler": "^3.99.0"
  }
}
